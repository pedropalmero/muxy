diff --git a/Muxy/Services/FileSystemWatcherHub.swift b/Muxy/Services/FileSystemWatcherHub.swift
new file mode 100644
index 0000000..3c2ac98
--- /dev/null
+++ b/Muxy/Services/FileSystemWatcherHub.swift
@@ -0,0 +1,89 @@
+import Foundation
+
+final class FileSystemWatcherSubscription: @unchecked Sendable {
+    fileprivate let id = UUID()
+    fileprivate let directoryPath: String
+    fileprivate weak var hub: FileSystemWatcherHub?
+
+    fileprivate init(directoryPath: String, hub: FileSystemWatcherHub) {
+        self.directoryPath = directoryPath
+        self.hub = hub
+    }
+
+    deinit {
+        hub?.unsubscribe(id: id, directoryPath: directoryPath)
+    }
+}
+
+final class FileSystemWatcherHub: @unchecked Sendable {
+    static let shared = FileSystemWatcherHub()
+
+    private struct Entry {
+        let watcher: FileSystemWatcher
+        var handlers: [UUID: @Sendable () -> Void]
+    }
+
+    private let lock = NSLock()
+    private var entries: [String: Entry] = [:]
+
+    func subscribe(
+        directoryPath: String,
+        handler: @escaping @Sendable () -> Void
+    ) -> FileSystemWatcherSubscription? {
+        let subscription = FileSystemWatcherSubscription(directoryPath: directoryPath, hub: self)
+
+        lock.lock()
+        if var entry = entries[directoryPath] {
+            entry.handlers[subscription.id] = handler
+            entries[directoryPath] = entry
+            lock.unlock()
+            return subscription
+        }
+        lock.unlock()
+
+        guard let watcher = FileSystemWatcher(directoryPath: directoryPath, handler: { [weak self] in
+            self?.fire(directoryPath: directoryPath)
+        })
+        else {
+            return nil
+        }
+
+        lock.lock()
+        if var entry = entries[directoryPath] {
+            entry.handlers[subscription.id] = handler
+            entries[directoryPath] = entry
+        } else {
+            entries[directoryPath] = Entry(
+                watcher: watcher,
+                handlers: [subscription.id: handler]
+            )
+        }
+        lock.unlock()
+
+        return subscription
+    }
+
+    fileprivate func unsubscribe(id: UUID, directoryPath: String) {
+        lock.lock()
+        guard var entry = entries[directoryPath] else {
+            lock.unlock()
+            return
+        }
+        entry.handlers.removeValue(forKey: id)
+        if entry.handlers.isEmpty {
+            entries.removeValue(forKey: directoryPath)
+        } else {
+            entries[directoryPath] = entry
+        }
+        lock.unlock()
+    }
+
+    private func fire(directoryPath: String) {
+        lock.lock()
+        let handlers = entries[directoryPath]?.handlers.values.map(\.self) ?? []
+        lock.unlock()
+        for handler in handlers {
+            handler()
+        }
+    }
+}
